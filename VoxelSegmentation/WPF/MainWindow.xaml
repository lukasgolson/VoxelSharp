<wpf:ThemedWindow x:Class="VoxelSegmentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:wpf="clr-namespace:VoxelSegmentation.WPF"
        Title="Voxel Segmentation Editor" Height="800" Width="1200"
        ResizeMode="CanResize"  
        Icon="pack://application:,,,/VoxelSegmentation;component/WPF/Icons/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="Open Project..." />
                <MenuItem Header="Save Project" />
                <MenuItem Header="_Settings..." Click="MenuSettings_Click" />

                <Separator />
                <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="_Edit" />
            <MenuItem Header="_Tools" />
            <MenuItem Header="_View" />
            <MenuItem Header="_Help" />
        </Menu>

        <Border Grid.Row="1" Margin="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtProgressLabel" Text="Progress Bar:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ProgressBar x:Name="GlobalProgressBar" Width="200" Height="15" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtGlobalProgress" Text="Idle" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" /> <ColumnDefinition Width="5" />  <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*" /> <RowDefinition Height="5" />  <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="3D Viewport" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/>    </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="2,2,10,2">
                            <StackPanel Width="90">
                                <TextBlock Text="Tools" FontWeight="Bold" Margin="0,0,0,5"/>
                                <RadioButton x:Name="ToolCamera" Content="Orbit/Pan" GroupName="Tools" IsChecked="True" Margin="0,2"/>
                                <RadioButton x:Name="ToolSelect" Content="Select" GroupName="Tools" Margin="0,2"/>
                                <RadioButton x:Name="ToolPaint" Content="Paint" GroupName="Tools" Margin="0,2"/>
                                <RadioButton x:Name="ToolErase" Content="Erase" GroupName="Tools" Margin="0,2"/>
                
                                <Separator Margin="0,10"/>
                
                                <TextBlock Text="Label Class" FontWeight="Bold" Margin="0,0,0,5"/>
                                <RadioButton x:Name="ClassHealthy" Content="Healthy" GroupName="Classes" IsChecked="True" Margin="0,2"/>
                                <RadioButton x:Name="ClassUnhealthy" Content="Unhealthy" GroupName="Classes" Margin="0,2"/>
                                <RadioButton x:Name="ClassWood" Content="Trunk/Stem" GroupName="Classes" Margin="0,2"/>
                                <RadioButton x:Name="ClassGround" Content="Ground" GroupName="Classes" Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="Black" Margin="2">
                            <glWpfControl:GLWpfControl x:Name="OpenTkControl" 
                                                       Render="OpenTkControl_OnRender" 
                                                       Ready="OpenTkControl_OnReady" 
                                                       MouseDown="OpenTkControl_OnMouseDown"
                                                       MouseUp="OpenTkControl_OnMouseUp"
                                                       SizeChanged="OpenTkControl_OnSizeChanged" />
                        </Border>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

                <GroupBox Grid.Row="2" Header="System Log" Margin="0,2,0,0">


                    <TextBox x:Name="TxtConsoleLog"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="System initialized...&#x0a;Ready." />

                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" /> <RowDefinition Height="5" />  <RowDefinition Height="6*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Inspector &amp; Tools" Margin="0,0,0,2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Import Settings" FontWeight="Bold" Margin="0,0,0,5" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Voxel Size:" VerticalAlignment="Center"
                                           Margin="0,2,10,2" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputVoxelSize" Text="1.0" Margin="0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Classification:"
                                           VerticalAlignment="Center" Margin="0,2,10,2" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="InputClassification" Text="Default"
                                         Margin="0,2" />
                            </Grid>

                            <Separator Margin="0,5" />

                            <TextBlock Text="Asset Details" FontWeight="Bold" Margin="0,5,0,5" />
                            <TextBlock Text="No object selected." FontStyle="Italic" />
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

                <GroupBox Grid.Row="2" Header="File Explorer" Margin="0,2,0,0">
                    <TreeView x:Name="FileViewerTree" SelectedItemChanged="FileViewerTree_SelectedItemChanged"
                              Margin="2">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubFiles}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗁 " />
                                    <TextBlock Text="{Binding ModelName}" />
                                </StackPanel>

                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 " />
                                            <TextBlock Text="{Binding FileName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </GroupBox>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>    <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="TxtStatus" Text="Ready"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="2">
                <TextBlock x:Name="TxtPerformance" Text="FPS: 0 | TPS: 0" Foreground="#555555" FontFamily="Consolas"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="3">
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
            </StatusBarItem>

            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="TxtCoordinates" Text="LAT: 0.0000 LON: 0.0000" FontFamily="Consolas"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</wpf:ThemedWindow>