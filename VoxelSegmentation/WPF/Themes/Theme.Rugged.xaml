<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    
    <system:String x:Key="ThemeDisplayName">Field work Green</system:String>

    
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#4E5744" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#707B64" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#5B6650" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#343B2D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#1A1E16" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6E8E3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8E9982" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252A20" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6E8E3" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B24C00" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#4E5744" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#4E5744" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6E8E3" />

    <LinearGradientBrush x:Key="{x:Static SystemColors.ActiveCaptionBrushKey}" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1E16" Offset="0.0" />
        <GradientStop Color="#343B2D" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static SystemColors.InactiveCaptionBrushKey}" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#252A20" Offset="0.0" />
        <GradientStop Color="#252A20" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionTextBrushKey}" Color="#FFCC00" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionTextBrushKey}" Color="#606A55" />
    
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#5C6650" />

    <StaticResource x:Key="DefragPendingBrush" ResourceKey="{x:Static SystemColors.WindowBrushKey}" />
    <StaticResource x:Key="DefragCompleteBrush" ResourceKey="{x:Static SystemColors.HighlightBrushKey}" />

    <SolidColorBrush x:Key="DefragActiveBrush" Color="Red" />
    <SolidColorBrush x:Key="DefragErrorBrush" Color="Black" />

</ResourceDictionary>