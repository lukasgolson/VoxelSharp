<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">      
    
    <system:String x:Key="ThemeDisplayName">CRT</system:String>

    
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#33FF33" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#113311" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#004400" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#002200" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#33FF33" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#006600" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#000000" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#33FF33" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#33FF33" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#000000" />
    
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#33FF33" />

    <LinearGradientBrush x:Key="{x:Static SystemColors.ActiveCaptionBrushKey}" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#006600" Offset="0.0" /><GradientStop Color="#003300" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static SystemColors.InactiveCaptionBrushKey}" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#111111" Offset="0.0" /><GradientStop Color="#000000" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionTextBrushKey}" Color="#33FF33" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionTextBrushKey}" Color="#004400" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1A331A" />

    <StaticResource x:Key="DefragPendingBrush" ResourceKey="{x:Static SystemColors.WindowBrushKey}" />
    <StaticResource x:Key="DefragCompleteBrush" ResourceKey="{x:Static SystemColors.HighlightBrushKey}" />

    <SolidColorBrush x:Key="DefragActiveBrush" Color="Red" />
    <SolidColorBrush x:Key="DefragErrorBrush" Color="Black" />
</ResourceDictionary>