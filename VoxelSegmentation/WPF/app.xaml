<Application x:Class="VoxelSegmentation.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/PresentationFramework.Classic;component/themes/Classic.xaml" />

                <ResourceDictionary Source="/WPF/Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="/WPF/Themes/Theme.Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>