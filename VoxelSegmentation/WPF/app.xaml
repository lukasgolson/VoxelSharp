<Application x:Class="VoxelSegmentation.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:VoxelSegmentation.WPF"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPF/Themes/Theme.Controls.xaml" />
                
                <ResourceDictionary Source="/WPF/Themes/Theme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type wpf:ThemedWindow}" BasedOn="{StaticResource ClassicWindowStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>