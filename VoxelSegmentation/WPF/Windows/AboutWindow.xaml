<wpf:ThemedWindow x:Class="Downloader.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:VoxelSegmentation.WPF"
        Title="About Downloader"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/VoxelSegmentation;component/WPF/Icons/icon.ico"
        MinWidth="320">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Source="pack://application:,,,/VoxelSegmentation;component/WPF/Icons/icon.ico" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,15,0"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock x:Name="lblTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                <TextBlock x:Name="lblVersion" Margin="0,0,0,4" />
                <TextBlock x:Name="lblCopyright" Margin="0,0,0,8"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

                <TextBlock x:Name="lblDescription" TextWrapping="Wrap" MaxWidth="280" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Click="BtnOK_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</wpf:ThemedWindow>