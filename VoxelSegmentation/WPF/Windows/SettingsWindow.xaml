<wpf:ThemedWindow x:Class="VoxelSegmentation.WPF.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:VoxelSegmentation.WPF"
        Title="Settings" Height="170" Width="320"
       
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/VoxelSegmentation;component/WPF/Icons/icon.ico">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Appearance" Grid.Row="0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="cmbTheme" Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Apply" Width="75" Margin="0,0,8,0" Click="BtnOK_Click" IsDefault="True" />
            <Button Content="Cancel" Width="75" Margin="0,0,8,0" Click="BtnCancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</wpf:ThemedWindow>