<Window x:Class="Downloader.RetroMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ClassicWindowStyle}"
        Icon="/icons/icon.ico"
        MinWidth="280" MaxWidth="500">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <Image x:Name="imgIcon" Width="32" Height="32" Margin="0,0,15,0"
                   VerticalAlignment="Top" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

            <TextBlock x:Name="txtMessage" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>

        <StackPanel x:Name="pnlButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
        </StackPanel>
    </Grid>
</Window>